{
  "name": "SSW Reborn",
  "description": "Custom CSS for SSW system",
  "version": "1.16",
  "content_scripts": [
    {
      "matches": [
        "https://*.ssw.inf.br/bin/*"
      ],
      "all_frames": true,
      "js": [
        "ssw-reborn.js"
      ],
      "run_at": "document_start"
    }
  ],
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://*.ssw.inf.br/bin/*"
  ],
  "incognito": "split",
  "action": {
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/ssw-reborn-16.png",
    "48": "icons/ssw-reborn-48.png",
    "128": "icons/ssw-reborn-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "data.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}